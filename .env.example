# API
PORT=4000
DATA_DIR=./data
CLIENT_URL=http://localhost:5173
# Public URL the platforms can reach to pull media (Instagram/TikTok need public media URLs in live mode)
PUBLIC_BASE_URL=
# Encrypts stored client secrets and tokens at rest (AES-256-GCM). Change in production.
SECRET_KEY=change-me-in-production
# Scheduler poll interval
SCHEDULER_INTERVAL_MS=30000
# Optional fallback for Claude. Keys for Anthropic and Kimi (Moonshot) can also be saved in Settings → AI providers,
# where they are encrypted at rest. Without any key the assistant runs in offline mock mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
