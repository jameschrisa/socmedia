# API
PORT=4000
DATA_DIR=./data
CLIENT_URL=http://localhost:5173
# Public URL the platforms can reach to pull media (Instagram/TikTok need public media URLs in live mode)
PUBLIC_BASE_URL=
# Encrypts stored client secrets and tokens at rest (AES-256-GCM). Change in production.
SECRET_KEY=change-me-in-production
# Scheduler poll interval
SCHEDULER_INTERVAL_MS=30000
# Optional fallback for Claude. Keys for Anthropic and Kimi (Moonshot) can also be saved in Settings → AI providers,
# where they are encrypted at rest. Without any key the assistant runs in offline mock mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Sign-in
# Bootstrap owner (created on first start when no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Root administrators: comma-separated emails that are always owners over every organization,
# whatever the sign-in domain policy below would grant them, and that no admin can demote,
# narrow, deactivate or delete from inside the app. Set on the host, not in the app, so handing
# out root needs server access. Everyone else is confined to the orgs their domain entry names.
ROOT_ADMIN_EMAILS=
# Google sign-in: OAuth 2.0 Web client whose redirect URI is <CLIENT_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID sign-in: app registration whose redirect URI is <CLIENT_URL>/api/auth/entra/callback
# Tenant defaults to "organizations" (any work or school account); set a tenant id to restrict to one directory.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Magic links and access-request notices: log (default; links go to the Console), resend or smtp
MAIL_PROVIDER=log
MAIL_FROM=
RESEND_API_KEY=
SMTP_URL=
