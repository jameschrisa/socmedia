{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src", "../shared/src"],
  "exclude": ["src/**/*.test.ts", "../shared/src/**/*.test.ts"]
}
